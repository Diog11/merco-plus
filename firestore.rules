rules_version = '2';

// Règles de départ : accès réservé aux utilisateurs authentifiés.
// À affiner ensuite par rôle (gérant / réceptionniste / technicien /
// magasinier / comptable — voir le cahier des charges, §4.2) une fois
// l'authentification Firebase (firebase_auth) branchée sur un vrai
// système de comptes utilisateurs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
